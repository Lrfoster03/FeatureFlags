{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ApiKeys": {
    "Default": "dev-secret-key"
  },
  "RateLimits": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 1
  },
  "InvitationEmail": {
    "PublicBaseUrl": "http://localhost:8080",
    "From": "Feature Flags <invites@example.test>",
    "PickupDirectory": "App_Data/invitation-mail"
  }
}
