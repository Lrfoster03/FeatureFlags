@page "/projects/{ProjectId}/settings"
@rendermode InteractiveServer
@attribute [Authorize]

@using System.Security.Claims
@using System.Security.Cryptography
@using FeatureFlags.Components.Models
@using FeatureFlags.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using FeatureFlags.Services

@inject IDbContextFactory<FeatureFlagDbContext> DbFactory
@inject ProjectChanges Changes
@inject AuthenticationStateProvider AuthenticationStateProvider

@inject IProjectPermissionService PermissionService

<PageTitle>Settings</PageTitle>

<h1>Project Settings</h1>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}

@if (canView)
{
<fieldset disabled="@isSaving" class="border-0 p-0 m-0">
<div class="card p-3 mb-4">
    <h4>Add Project Member</h4>

    <div class="mb-3">
        <label class="form-label">User Email</label>
        <input class="form-control" @bind="memberEmail" />
    </div>

    <div class="mb-3">
        <label class="form-label">Role</label>
        <select class="form-select" @bind="selectedRole">
            <option value="@ProjectRole.Viewer">Viewer</option>
            <option value="@ProjectRole.Editor">Editor</option>
            <option value="@ProjectRole.Admin">Admin</option>
            <option value="@ProjectRole.Owner">Owner</option>
        </select>
    </div>

    <button class="btn btn-primary" disabled="@(!canManageMembers)" @onclick="AddMember">Add Member</button>
</div>

<div class="card p-3 mb-4">
    <h4>Members</h4>

    <table class="table">
        <thead>
            <tr>
                <th>Email</th>
                <th>Display Name</th>
                <th>User Id</th>
                <th>Role</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var member in members)
            {
                <tr>
                    <td>@member.Email</td>
                    <td>@(string.IsNullOrWhiteSpace(member.DisplayName) ? "—" : member.DisplayName)</td>
                    <td><code>@member.UserId</code></td>
                    <td>@member.Role</td>
                    <td>
                        @if (member.RevokedAt is null)
                        {
                            <select class="form-select form-select-sm" value="@member.Role"
                                    disabled="@(!canManageMembers)" @onchange="e => UpdateMemberRole(member, e)">
                                <option value="@ProjectRole.Viewer">Viewer</option>
                                <option value="@ProjectRole.Editor">Editor</option>
                                <option value="@ProjectRole.Admin">Admin</option>
                                <option value="@ProjectRole.Owner">Owner</option>
                            </select>
                        }
                    </td>

                    <td>
                        @if (member.RevokedAt is null)
                        {
                            <button class="btn btn-outline-danger btn-sm" disabled="@(!canManageMembers)" @onclick="() => RevokeMember(member)">
                                Remove
                            </button>
                        }
                        else
                        {
                            <span class="text-muted">Removed</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="card p-3 mb-4">
    <h4>API Keys</h4>
    <p class="text-muted mb-3">
        Public client keys identify this project environment when calling the feature flag API.
    </p>

    <div class="row g-3 align-items-end mb-3">
        <div class="col-md-8">
            <label class="form-label">Key Name</label>
            <input class="form-control" @bind="newKeyName" placeholder="Local dev, production app, etc." />
        </div>
        <div class="col-md-4">
            <button class="btn btn-primary w-100" disabled="@(!canManageKeys)" @onclick="GenerateKey">Generate Key</button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(generatedKey))
    {
        <div class="alert alert-success">
            <div class="fw-semibold mb-1">New key generated</div>
            <div class="small mb-2">Copy this key for your SDK/client configuration.</div>
            <code style="word-break: break-all;">@generatedKey</code>
        </div>
    }

    <table class="table">
        <thead>
            <tr>
                <th>Key Name</th>
                <th>Key</th>
                <th>Created At</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var key in keys)
            {
                <tr>
                    <td>@key.Name</td>
                    <td><code>@key.Key</code></td>
                    <td>@key.CreatedAt</td>
                    <td>@(key.RevokedAt.HasValue ? key.RevokedAt.Value.ToString() : "Active")</td>
                    <td>
                        @if (key.RevokedAt is null)
                        {
                            <button class="btn btn-outline-danger btn-sm" disabled="@(!canManageKeys)" @onclick="() => RevokeKey(key)">
                                Revoke
                            </button>
                        }
                        else
                        {
                            <span class="text-muted">Revoked</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

</fieldset>
}

@code {
    [Parameter] public string ProjectId { get; set; } = "";
    private string? loadedProject;
    private int environmentId;
    private string memberEmail = "";
    private ProjectRole selectedRole = ProjectRole.Viewer;
    private string? errorMessage;
    private string? successMessage;
    private List<ProjectMember> members = [];
    private List<ClientKey> keys = [];
    private string newKeyName = "";
    private string? generatedKey;
    private bool isSaving;
    private bool canView;
    private bool canManageMembers;
    private bool canManageKeys;
    private readonly Dictionary<string, Guid> pendingOperations = [];

    protected override async Task OnParametersSetAsync()
    {
        if (loadedProject == ProjectId) return;
        loadedProject = ProjectId;
        members = []; keys = []; generatedKey = null; pendingOperations.Clear();
        errorMessage = null; successMessage = null;
        var userId = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.FindFirstValue(ClaimTypes.NameIdentifier);
        canView = await PermissionService.CanViewProjectAsync(ProjectId, userId);
        if (!canView) { errorMessage = "You do not have permission to view this project."; return; }
        canManageMembers = await PermissionService.CanManageMembersAsync(ProjectId, userId);
        canManageKeys = await PermissionService.CanManageKeysAsync(ProjectId, userId);
        await using var db = await DbFactory.CreateDbContextAsync();
        environmentId = await db.ProjectEnvironments.Where(e => e.ProjectId == ProjectId).OrderBy(e => e.Id).Select(e => e.Id).FirstOrDefaultAsync();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        members = await db.ProjectMembers.AsNoTracking().Where(m => m.ProjectId == ProjectId)
            .OrderBy(m => m.RevokedAt != null).ThenBy(m => m.Role).ToListAsync();
        keys = await db.ClientKeys.AsNoTracking().Where(k => k.ProjectEnvironment.ProjectId == ProjectId).OrderBy(k => k.CreatedAt).ToListAsync();
    }

    private Task GenerateKey() => MutateAsync($"generate-{newKeyName}",
        id => Changes.GenerateKeyAsync(ProjectId, environmentId, newKeyName, id), "API key generated.", events =>
        {
            generatedKey = keys.Single(k => k.Id.ToString() == events.Single().EntityId).Key;
            newKeyName = "";
        });
    private Task RevokeKey(ClientKey key) => MutateAsync($"revoke-{key.Id}",
        id => Changes.RevokeKeyAsync(ProjectId, key.Id, key.Revision, id), "API key revoked.");
    private Task AddMember() => MutateAsync($"add-member-{memberEmail}-{selectedRole}",
        id => Changes.AddMemberAsync(ProjectId, memberEmail, selectedRole, id), "Project member added or restored.", _ => memberEmail = "");
    private Task UpdateMemberRole(ProjectMember member, ChangeEventArgs args)
    {
        if (!Enum.TryParse<ProjectRole>(args.Value?.ToString(), out var role) || !Enum.IsDefined(role))
        { errorMessage = "Invalid role."; return Task.CompletedTask; }
        return MutateAsync($"role-{member.Id}-{role}", id => Changes.ChangeMemberAsync(ProjectId, member.Id, member.Revision, role, id), "Member role updated.");
    }
    private Task RevokeMember(ProjectMember member) => MutateAsync($"remove-{member.Id}",
        id => Changes.ChangeMemberAsync(ProjectId, member.Id, member.Revision, null, id), "Project member removed.");

    private async Task MutateAsync(string action, Func<Guid, Task<IReadOnlyList<AuditEvent>>> mutation, string success,
        Action<IReadOnlyList<AuditEvent>>? after = null)
    {
        if (isSaving) return;
        isSaving = true; errorMessage = null; successMessage = null;
        if (!pendingOperations.TryGetValue(action, out var operation)) pendingOperations[action] = operation = Guid.NewGuid();
        try
        {
            var events = await mutation(operation);
            await ReloadAsync();
            after?.Invoke(events);
            pendingOperations.Remove(action);
            successMessage = success;
        }
        catch (DbUpdateConcurrencyException)
        {
            errorMessage = "This item changed since you opened it. Review the refreshed information before trying again.";
            await ReloadAsync();
        }
        catch (ArgumentException ex) { errorMessage = ex.Message; }
        catch (UnauthorizedAccessException ex) { errorMessage = ex.Message; }
        catch (Exception) { errorMessage = "Failed to save changes. Please retry."; }
        finally { isSaving = false; }
    }
}
