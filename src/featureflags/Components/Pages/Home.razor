@page "/projects/{ProjectId}/home"
@rendermode InteractiveServer
@using FeatureFlags.Components.Models
@using FeatureFlags.Components.Shared
@using FeatureFlags.Data
@using FeatureFlags.Services
@using Microsoft.EntityFrameworkCore
@using BlazorBootstrap
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization

@inject IDbContextFactory<FeatureFlagDbContext> DbFactory
@inject ProjectChanges Changes
@inject IFeatureFlagConfirmationService ConfirmationService
@inject IProjectPermissionService PermissionService
@inject AuthenticationStateProvider AuthenticationStateProvider

@inject NavigationManager Navigation

@attribute [Authorize]

<PageTitle>Feature Flags</PageTitle>


<fieldset disabled="@isSaving" class="border-0 p-0 m-0">
<div style="overflow-y: scroll;">
    <section class="mb-4">
        <div class="d-flex align-items-center justify-content-between px-2">
            <h1 style="margin: 0;">Feature Flags</h1>
            <div class="gap-2">
                <span class="badge bg-secondary">@featureFlags.Count</span>
                <button class="btn btn-primary" @onclick="AddFlag">Add Flag</button>
            </div>
        </div>

        @if (featureFlags.Count == 0)
        {
            <div class="alert alert-info mt-3 mb-0">No feature flags have been created for this project.</div>
        }
        else
        {
            <ul class="list-group">
                @foreach (var flag in featureFlags)
                {
                    <div @key="(flag.Id, editorVersion)" style="padding: 0.5rem; border-radius: 0.25rem;">
                        <FlagPill FeatureFlag="flag" OnChanged="MarkConfigDirty" OnDelete="DeleteFeatureFlag" />
                    </div>
                }
            </ul>
        }
    </section>

    <section>
        <div class="d-flex align-items-center justify-content-between px-2">
            <h1 style="margin: 0;">Configs</h1>
            <div class="gap-2">
                <span class="badge bg-secondary">@featureConfigs.Count</span>
                <button class="btn btn-primary" @onclick="AddConfig">Add Config</button>
            </div>
        </div>

        @if (featureConfigs.Count == 0)
        {
            <div class="alert alert-info mt-3 mb-0">No configs have been created for this project.</div>
        }
        else
        {
            <ul class="list-group">
                @foreach (var config in featureConfigs)
                {
                    <div @key="(config.Id, editorVersion)" style="padding: 0.5rem; border-radius: 0.25rem;">
                        <ConfigPill Config="config" OnChanged="MarkConfigDirty" OnDelete="DeleteFeatureConfig" />
                    </div>
                }
            </ul>
        }
    </section>

    @if (HasUnsavedChanges)
    {
        <div style="position: fixed; bottom: 1rem; right: 1rem; z-index: 2000; min-width: 360px;">
            <Alert Color="AlertColor.Warning">
                <div class="d-flex align-items-center justify-content-between gap-3">
                    <span>You have unsaved changes.</span>
                    <div class="d-flex gap-2">
                        <Button Color="ButtonColor.Success" Size="ButtonSize.Small" @onclick="SaveAllChanges">
                            Save
                        </Button>
                        <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small" @onclick="DiscardAllChanges">
                            Discard
                        </Button>
                    </div>
                </div>
            </Alert>
        </div>
    }
</div>

</fieldset>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div style="position: fixed; bottom: 5rem; right: 1rem; z-index: 2001; min-width: 320px;">
        <Alert Color="AlertColor.Danger" Dismissable="true">
            @errorMessage
        </Alert>
    </div>
}

<ConfirmDialog @ref="confirmDialog" />

@code {
    [Parameter] public string ProjectId { get; set; } = "";
    private List<FeatureFlag> featureFlags = [];
    private List<FeatureConfig> featureConfigs = [];
    private readonly Dictionary<(Type, int), IConfig> dirtyConfigs = [];
    private readonly Dictionary<string, Guid> pendingOperations = [];
    private bool HasUnsavedChanges => dirtyConfigs.Count > 0;
    private string? errorMessage;
    private ConfirmDialog confirmDialog = default!;
    private ProjectEnvironment? environment;
    private string? loadedProject;
    private bool isSaving;
    private int editorVersion;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedProject == ProjectId) return;
        loadedProject = ProjectId;
        environment = null;
        dirtyConfigs.Clear(); pendingOperations.Clear();
        featureFlags = []; featureConfigs = []; errorMessage = null;
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        if (!await PermissionService.CanViewProjectAsync(ProjectId, user.FindFirstValue(ClaimTypes.NameIdentifier)))
        {
            errorMessage = "You do not have permission to access this project.";
            return;
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        environment = await db.ProjectEnvironments.AsNoTracking().Where(e => e.ProjectId == ProjectId).OrderBy(e => e.Id).FirstOrDefaultAsync();
        if (environment is null) { errorMessage = "No project environment found for this project."; return; }
        await ReloadConfigsAsync();
    }

    private async Task ReloadConfigsAsync()
    {
        if (environment is null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var flags = await db.FeatureFlags.AsNoTracking().Where(f => f.ProjectEnvironmentId == environment.Id).OrderBy(f => f.Name).ToListAsync();
        var configs = await db.Configs.AsNoTracking().Where(c => c.ProjectEnvironmentId == environment.Id).OrderBy(c => c.Name).ToListAsync();
        featureFlags = flags.Select(f => dirtyConfigs.TryGetValue((typeof(FeatureFlag), f.Id), out var draft) ? (FeatureFlag)draft : f).ToList();
        featureConfigs = configs.Select(c => dirtyConfigs.TryGetValue((typeof(FeatureConfig), c.Id), out var draft) ? (FeatureConfig)draft : c).ToList();
    }

    private Task AddFlag() => AddItem(false);
    private Task AddConfig() => AddItem(true);
    private async Task AddItem(bool config)
    {
        if (environment is null) return;
        await MutateAsync(config ? "add-config" : "add-flag", id => Changes.AddItemAsync(ProjectId, environment.Id, config, id));
    }

    private Task MarkConfigDirty(IConfig config)
    {
        dirtyConfigs[(config.GetType(), config.Id)] = config;
        pendingOperations.Remove("save");
        return Task.CompletedTask;
    }

    private Task DeleteFeatureFlag(FeatureFlag flag) => DeleteItem(flag, "feature flag");
    private Task DeleteFeatureConfig(FeatureConfig config) => DeleteItem(config, "feature config");
    private async Task DeleteItem(IConfig item, string label)
    {
        if (isSaving || !await ConfirmationService.ConfirmDeleteAsync(confirmDialog, item.Name)) return;
        await MutateAsync($"delete-{item.GetType().Name}-{item.Id}", id => Changes.DeleteItemAsync(ProjectId, item, id),
            () => dirtyConfigs.Remove((item.GetType(), item.Id)), $"Failed to delete {label} '{item.Name}'.");
    }

    private Task SaveAllChanges() => MutateAsync("save", id => Changes.SaveItemsAsync(ProjectId, dirtyConfigs.Values.ToArray(), id), () =>
    {
        dirtyConfigs.Clear(); editorVersion++;
    });

    private async Task MutateAsync(string action, Func<Guid, Task> mutation, Action? saved = null, string? failureMessage = null)
    {
        if (isSaving) return;
        isSaving = true; errorMessage = null;
        if (!pendingOperations.TryGetValue(action, out var operation)) pendingOperations[action] = operation = Guid.NewGuid();
        try
        {
            await mutation(operation);
            saved?.Invoke();
            await ReloadConfigsAsync();
            pendingOperations.Remove(action);
        }
        catch (DbUpdateConcurrencyException)
        {
            errorMessage = "This item changed since you opened it. Discard to reload, then review the latest version before saving.";
        }
        catch (UnauthorizedAccessException ex) { errorMessage = ex.Message; }
        catch (ArgumentException ex) { errorMessage = ex.Message; }
        catch (Exception) { errorMessage = failureMessage ?? "Failed to save changes. Your edits have been kept; check for duplicate names or retry."; }
        finally { isSaving = false; }
    }

    private async Task DiscardAllChanges()
    {
        if (isSaving) return;
        errorMessage = null; dirtyConfigs.Clear(); pendingOperations.Clear(); editorVersion++;
        await ReloadConfigsAsync();
    }
}
